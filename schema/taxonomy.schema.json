{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://postmed-qbank.local/schema/taxonomy.schema.json",
  "title": "科目、章節、來源（規格書 §4.2）",
  "type": "object", "additionalProperties": false,
  "required": ["subjects", "chapters", "source_kinds", "sources"],
  "properties": {
    "subjects": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "name", "id_pattern", "ink"],
      "properties": {"id": {"type": "string", "pattern": "^[A-Z]{3}$"}, "name": {"type": "string"}, "id_pattern": {"type": "string"},
                     "ink": {"enum": ["per_attempt", "keep"]}}}},
    "chapters": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "subject", "parent", "title", "order"],
      "properties": {"id": {"type": "string", "pattern": "^[A-Z]{3}:.+$"}, "subject": {"type": "string"}, "parent": {"type": ["string", "null"]},
                     "title": {"type": "string"}, "order": {"type": "integer"}, "book": {"type": ["string", "null"]}}}},
    "source_kinds": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "name", "group"],
      "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "group": {"type": "string", "description": "出題設定預設勾選用：postmed＝後醫"}}}},
    "sources": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["sid", "subject", "kind", "school", "year", "paper", "book", "unit", "count"],
      "properties": {"sid": {"type": "string"}, "subject": {"type": "string"}, "kind": {"type": "string"},
                     "school": {"type": ["string", "null"]}, "year": {"type": ["integer", "null"]}, "paper": {"type": ["string", "null"]},
                     "book": {"type": ["string", "null"]}, "unit": {"type": ["string", "null"]}, "count": {"type": "integer", "minimum": 1}}}}
  }
}
